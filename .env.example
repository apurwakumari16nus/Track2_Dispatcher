LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_INTAKE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_INTAKE_MODEL=

# Telegram channel (src/telegram_bot.py). Create the bot with @BotFather; never commit the token.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs allowed to use the bot. Send /chatid in a chat to see its ID.
TELEGRAM_ALLOWED_CHATS=
# live (default), cached or fixture
TELEGRAM_READING=live
