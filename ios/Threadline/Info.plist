<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Threadline</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.adityapandhari.threadline</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>threadline</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Threadline connects to your dispatch desk on this network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Threadline listens while you speak a request, so you can see it written as you talk.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your words are turned into text on this iPhone and on your desk Mac so Threadline can read the request.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>ThreadlineHost</key>
	<string>$(THREADLINE_HOST)</string>
	<key>ThreadlineProbe</key>
	<string>$(THREADLINE_PROBE)</string>
	<key>ThreadlineToken</key>
	<string>$(THREADLINE_TOKEN)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
